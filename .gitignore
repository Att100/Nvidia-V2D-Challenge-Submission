# The official kit contains required public templates of these types.
*.parquet
!robotic_grounding/third_party/v2d_submission_kit/v2d_submission_kit/data/*.parquet

# Licensed MANO files and derived helper data are installed locally.
reconstruction/thirdparty/MANO/mano_data/*
!reconstruction/thirdparty/MANO/mano_data/.gitkeep
reconstruction/thirdparty/HACO_RELEASE/data/base_data/human_models/mano/*
!reconstruction/thirdparty/HACO_RELEASE/data/base_data/human_models/mano/.gitkeep

