# Credentials and local configuration
.env
.env.*
!.env.example
kaggle.json
*.pem
*.key

# Python and tool caches
__pycache__/
*.py[codz]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/

# Generated reconstruction, grounding, and RL artifacts
artifacts/
outputs/
results/
submission/
slurm-*.out
*.safetensors
*.ckpt
*.pth
*.pt
*.onnx
*.mp4
*.webm
*.glb
*.obj
